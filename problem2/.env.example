# Copy to .env and fill in. Never commit the real .env file.

# Qwen (OpenAI-compatible protocol, DashScope compatible mode)
DASHSCOPE_API_KEY=
# Endpoint differs by region; check the DashScope documentation.
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Gemini (Google native protocol)
GEMINI_API_KEY=
GEMINI_MODEL=

# Context window of the model in tokens (older history is compacted at 80% of it)
MINI_AGENT_CONTEXT_WINDOW=128000
